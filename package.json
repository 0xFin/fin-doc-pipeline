{
  "name": "fin-doc-pipeline",
  "version": "0.7.1",
  "description": "Universal text-document pipeline: detect encoding, dedupe and merge multiple sources, lint and repair, typeset, and export to txt, md, html, rtf, docx, epub or pdf. Also reads docx and epub as input.",
  "type": "module",
  "bin": {
    "fin-doc-pipeline": "./src/cli.mjs",
    "fdp": "./src/cli.mjs"
  },
  "files": ["src", "web", "index.html", "SKILL.md", "README.md", "README.en.md", "CHANGELOG.md", "CONTRIBUTING.md", "LICENSE", "install.sh", "examples"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "test": "node test/run.mjs",
    "ship": "sh scripts/ship.sh",
    "status": "sh scripts/status.sh",
    "prepublishOnly": "node scripts/build-web.mjs --check && node test/run.mjs",
    "check": "node --check src/cli.mjs"
  },
  "keywords": ["text", "typography", "encoding", "dedupe", "merge", "chinese", "novel", "epub", "docx", "pdf", "markdown", "html", "json", "yaml", "xml", "csv", "cli", "agent-skill", "skill"],
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/0xFin/fin-doc-pipeline.git" },
  "homepage": "https://0xFin.github.io/fin-doc-pipeline/",
  "bugs": { "url": "https://github.com/0xFin/fin-doc-pipeline/issues" }
}